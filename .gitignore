# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
jspm_packages/
web_modules/
bower_components/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ── Build output ──────────────────────────────────────────────────────────────
dist
dist-ssr
build/Release
out
*.local

# ── Monorepo tooling caches ───────────────────────────────────────────────────
.turbo/
**/.turbo/

# ── Nix / devenv / direnv (state, not config; flake.lock IS committed) ─────────
.devenv*
.direnv/
devenv.local.nix
.pre-commit-config.yaml

# ── Logs ──────────────────────────────────────────────────────────────────────
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ── Runtime / caches ──────────────────────────────────────────────────────────
pids
*.pid
*.seed
*.pid.lock
lib-cov
coverage
*.lcov
.nyc_output
.grunt
.cache
.parcel-cache
.eslintcache
.stylelintcache
*.tsbuildinfo
.npm
.node_repl_history
*.tgz
.yarn-integrity
.vite

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Databases (never commit local/dev data) ──────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*.pyc.*
.Python
venv/
.venv/

# ── Debug / scratch artifacts ─────────────────────────────────────────────────
debug_*.txt
*_output.txt
*.tmp

# ── Duplicate copies created by editors / file managers (e.g. "file 2.js") ────
* [0-9].*
*\ copy.*
*\ copy\ *.*

# ── Editor / OS ───────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
.~lock.*#
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Vite timestamp files ──────────────────────────────────────────────────────
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
