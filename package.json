{
  "name": "datahub",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev:web": "pnpm --filter @datahub/web dev",
    "dev:api": "pnpm --filter @datahub/api dev",
    "dev:stack": "pnpm --parallel --filter @datahub/api --filter @datahub/web dev",
    "test:cov": "turbo run test:cov"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3"
  }
}
