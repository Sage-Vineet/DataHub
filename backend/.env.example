# ── Gemini AI (document extraction, COA refinement, cash-flow generation) ─────
GEMINI_API_KEY=your_gemini_api_key_here
# Model selection is DYNAMIC. Leave both unset to use the built-in default
# fallback chain (gemini-2.5-flash-lite → gemini-2.5-flash → gemini-2.0-flash).
#
#   GEMINI_MODEL   — a single primary model; the built-in defaults remain as
#                    fallbacks after it. e.g. GEMINI_MODEL=gemini-2.5-flash
#   GEMINI_MODELS  — a full comma-separated ordered override of the try-chain.
#                    e.g. GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash
# GEMINI_MODELS takes precedence over GEMINI_MODEL when both are set.
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash,gemini-2.0-flash
