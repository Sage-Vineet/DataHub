# =============================================================================
# DataHub API — environment template
#
# Copy to `.env` and fill in. NEVER commit `.env`, and never put a real secret
# in THIS file — it is tracked by git, so anything written here is published to
# everyone with repository access, permanently, including in history.
#
# The server validates these at startup (backend/src/config/env.js) and refuses
# to boot on a missing or weak value in production.
# =============================================================================

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ── Secrets ──────────────────────────────────────────────────────────────────
# Generate each with:  openssl rand -base64 48
# Minimum 32 characters. Access and refresh secrets MUST differ, so a token of
# one type can never be replayed as the other.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=datahub-api
JWT_AUDIENCE=datahub-app

# 32-byte key for AES-256-GCM encryption of sensitive columns.
# Generate with:  openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# ── Session and token lifetimes (seconds) ────────────────────────────────────
ACCESS_TOKEN_TTL_SECONDS=900              # 15 min — short by design
REFRESH_TOKEN_TTL_SECONDS=604800          # 7 days, absolute cap on refresh
SESSION_IDLE_TIMEOUT_SECONDS=1800         # 30 min of inactivity ends the session
SESSION_ABSOLUTE_TIMEOUT_SECONDS=43200    # 12 h regardless of activity
SINGLE_DEVICE_LOGIN=true                  # a new login revokes the previous one

# ── Password hashing ─────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12                          # minimum 12; raise as hardware improves

# ── Account lockout ──────────────────────────────────────────────────────────
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_SECONDS=900          # failures older than this stop counting
LOGIN_LOCKOUT_SECONDS=900                 # how long the account stays locked
LOGIN_LOCKOUT_NOTIFY=true                 # email the account holder on lockout

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_GLOBAL_MAX=600
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=900
RATE_LIMIT_BURST_MAX=40
RATE_LIMIT_BURST_WINDOW_SECONDS=5
RATE_LIMIT_BLOCK_SECONDS=900
RATE_LIMIT_BLOCK_THRESHOLD=5

# ── Transport ────────────────────────────────────────────────────────────────
# Number of proxy hops to trust for X-Forwarded-*. Render and Vercel each add
# exactly one. NEVER set this to `true` — that trusts a client-supplied
# X-Forwarded-For and lets an attacker spoof their IP past every rate limit.
TRUST_PROXY_HOPS=1
FORCE_HTTPS=true
HSTS_MAX_AGE_SECONDS=63072000             # 2 years, required for HSTS preload

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated exact origins. https:// only in production. No wildcards, and
# no "*.vercel.app" style patterns — anyone can deploy to vercel.app for free.
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,https://www.yourdomain.com
FRONTEND_URL=http://localhost:5173

# ── Uploads ──────────────────────────────────────────────────────────────────
UPLOAD_MAX_BYTES=209715200                # 200 MB
STORAGE_BUCKET=documents

# ── Supabase ─────────────────────────────────────────────────────────────────
# The service-role key bypasses Row Level Security. It is a full-database
# credential: server-side only, never in a VITE_* variable or any frontend code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Direct Postgres ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Keep TLS certificate verification ON. Setting this to false accepts ANY
# certificate, leaving the connection open to an active man-in-the-middle.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Supabase DIRECT connections (db.<ref>.supabase.co) present a certificate
# signed by a private root, "Supabase Root 2021 CA", which is NOT in Node's
# trust store. That root is bundled at backend/certs/supabase-prod-ca-2021.crt
# and loaded automatically, so verification works with no configuration.
# Set this ONLY for a non-Supabase database with its own private CA
# (inline PEM or a file path).
#   Verify the whole chain with:  npm run verify:db-tls
DATABASE_CA_CERT=

# Skip the idempotent DDL that runs at boot. Set to true once the migrations in
# backend/sql/migrations/ are applied by CI — the preferred production posture,
# since startup DDL needs an owner-level role at runtime.
SKIP_STARTUP_DDL=false

# ── Email (Microsoft Graph) ──────────────────────────────────────────────────
# Delivery uses the Graph API with the OAuth 2.0 client_credentials flow —
# see src/services/emailService.js. There is no SMTP path.
#
# REQUIRED AZURE SETUP (app-only, not delegated):
#   Entra ID → App registrations → <app> → API permissions
#     → Add a permission → Microsoft Graph → APPLICATION permissions
#     → Mail.Send → Add → "Grant admin consent for <tenant>"
#   The Status column must read "Granted". Delegated permissions are ignored
#   by client_credentials and will still produce HTTP 403.
#
#   Verify with:  npm run verify:graph
#
# Recommended least-privilege hardening — restrict the app to ONE mailbox,
# otherwise Mail.Send permits sending as ANY user in the tenant:
#   New-ApplicationAccessPolicy -AppId <client-id> `
#     -PolicyScopeGroupId <mail-enabled-security-group> `
#     -AccessRight RestrictAccess -Description "DataHub noreply only"
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_EMAIL=noreply@yourdomain.com
EMAIL_FROM_NAME="M&A Hub"

# ── QuickBooks OAuth 2.0 ─────────────────────────────────────────────────────
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_REDIRECT_URI=https://your-api.onrender.com/api/auth/callback
QB_ENVIRONMENT=production

# ── AI providers ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Model selection is dynamic; leave unset for the built-in fallback chain.
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash,gemini-2.0-flash

# ── QuickBooks API base ──────────────────────────────────────────────────────
# https://quickbooks.api.intuit.com for production,
# https://sandbox-quickbooks.api.intuit.com for sandbox.
QB_BASE_URL=https://quickbooks.api.intuit.com

# ── Public app URL ───────────────────────────────────────────────────────────
# Used to build absolute links in outbound email. Must be an origin you control:
# it ends up in messages sent to users, so a wrong value is a phishing vector.
APP_URL=http://localhost:5173

# ── Supabase anon key ────────────────────────────────────────────────────────
# Browser-facing key. It is NOT a secret, but it is only safe because Row Level
# Security denies it everything — see migration 090. Never widen its grants.
SUPABASE_ANON_KEY=

# ── S3-compatible object storage ─────────────────────────────────────────────
# Scope these credentials to the single bucket below. A root or account-wide key
# here turns one server compromise into full storage-account compromise.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_ENDPOINT_URL=
S3_PUBLIC_URL=
# Keep presigned URLs short-lived — anyone holding one can use it until it expires.
S3_PRESIGN_EXPIRES=900
S3_FORCE_PATH_STYLE=false
