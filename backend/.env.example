# Example environment for the legacy backend. PLACEHOLDERS ONLY.
#
# This file is tracked in git. Never put a working value in it — copy it to
# `backend/.env` (gitignored) and fill that in instead.
#
# It previously carried a real Gmail account and two live app passwords, which
# is how the credential in audit finding C3 reached the repository. Those values
# are still present in history; rotating them and purging history are tracked in
# `openspec/changes/secrets-rotation/` and `openspec/changes/secrets-history-purge/`.

# ── Existing variables ────────────────────────────────────────────────────────
PORT=4000
JWT_SECRET=your_jwt_secret_here
DATABASE_URL=postgresql://user:password@host:5432/dbname
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Email / Invitation service ────────────────────────────────────────────────
# SMTP server credentials (works with Gmail, SendGrid, Mailgun, AWS SES, etc.)
#
# For Gmail this must be an App Password, not the account password, and it
# belongs to a service mailbox rather than anyone's personal account.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false          # set to true for port 465 (SSL)
EMAIL_USER=your@email.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM="DataHub <noreply@yourdomain.com>"

# Frontend login URL included in the welcome email
FRONTEND_URL=http://localhost:5173
