# SPA (apps/web) configuration. Copy to .env.local for local overrides.

# Origin the SPA sends API requests to. This should be the GATEWAY (apps/api),
# not the legacy backend — the gateway transparently proxies everything it does
# not serve in-process, so it is the seam where per-domain cutover happens
# (ADR-0003). Pointing this at the legacy backend directly (:4000) bypasses the
# seam and makes every *_MODULE_ENABLED flag a no-op.
VITE_API_BASE_URL=http://localhost:8080
