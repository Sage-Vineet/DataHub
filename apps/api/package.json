{
  "name": "@datahub/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --conditions=development src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "route-surface": "tsx --conditions=development src/parity/write-route-surface.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.27",
    "@datahub/contracts": "workspace:*",
    "@datahub/db": "workspace:*",
    "@datahub/financial-engine": "workspace:*",
    "bcryptjs": "^2.4.3",
    "better-auth": "^1.6.27",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "http-proxy-middleware": "^3.0.3",
    "jsonwebtoken": "^9.0.2",
    "pino-http": "^10.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@datahub/config": "workspace:*",
    "@electric-sql/pglite": "^0.2.17",
    "@eslint/js": "^9.39.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.4",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.9"
  }
}
