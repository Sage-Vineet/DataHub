# Gateway (apps/api) configuration.

# Port the gateway listens on.
PORT=8080

# LEGACY_ORIGIN, API_ORIGIN and GATEWAY_ROUTES used to live here. They chose
# which upstream each path was proxied to; every route is served in-process now,
# so there is nothing to route between and an unmatched path is a 404.

# ── Auth ──────────────────────────────────────────────────────────────────────
# Better Auth serves /auth (ADR-0007). This was a choice between it, a bespoke
# module kept as a rollback target, and legacy; the other two are gone.
# DATABASE_URL=postgres://...            # required
# JWT_SECRET=...                         # required; mandatory + fail-closed (Better Auth reuses it)
# JWT_EXPIRES_IN=7d
# AUTH_LOGIN_RATE_WINDOW_MS=900000       # 15 min
# AUTH_LOGIN_RATE_MAX=10                 # failed logins per window before 429
# BETTER_AUTH_URL=https://api.example.com  # public base URL (Better Auth cookies/links)
# AUTH_TRUSTED_ORIGINS=https://app.example.com  # SPA origins for credentialed CORS + CSRF

# ── Domain modules ────────────────────────────────────────────────────────────
# There are no per-domain flags any more. Every module mounts unconditionally:
# each one was a cutover switch — on served the module, off fell through to the
# legacy backend — and with legacy gone "off" was a hole rather than a rollback.
#
# What remains below are CAPABILITY flags: features with no predecessor
# anywhere, where switching one off subtracts it rather than rolling back to
# something else.

# GRAPH_TENANT_ID / GRAPH_CLIENT_ID / GRAPH_CLIENT_SECRET / GRAPH_SENDER_EMAIL
#   — Microsoft Graph emailer (reset codes); console stub is used if unset.
