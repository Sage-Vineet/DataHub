# Gateway (apps/api) configuration.

# Port the gateway listens on.
PORT=8080

# Required. The legacy backend origin the gateway forwards to by default.
# In local dev the legacy backend (./backend) typically runs on :4000.
LEGACY_ORIGIN=http://127.0.0.1:4000

# Optional. Origin for new TypeScript modules, referenced by GATEWAY_ROUTES.
# API_ORIGIN=http://127.0.0.1:8081

# Optional. Per-route-group cutover table: comma/newline separated "prefix=origin".
# With this empty, 100% of traffic goes to legacy (transparent no-op).
# Example (flip auth to a separate service origin): GATEWAY_ROUTES=/api/auth=api
# GATEWAY_ROUTES=

# ── Auth module (in-process cutover) ──────────────────────────────────────────
# /api/auth is served by exactly one engine, chosen by flag (instant cutover/rollback):
#   BETTER_AUTH_ENABLED=true  → Better Auth (ADR-0007); wins if both are set.
#   AUTH_MODULE_ENABLED=true  → the bespoke module (rollback target).
#   neither                   → /api/auth falls through to legacy.
# Both require DATABASE_URL.
# BETTER_AUTH_ENABLED=false
# AUTH_MODULE_ENABLED=false
# DATABASE_URL=postgres://...            # required when any in-process module is enabled
# JWT_SECRET=...                         # required; mandatory + fail-closed (Better Auth reuses it)
# JWT_EXPIRES_IN=7d
# AUTH_LOGIN_RATE_WINDOW_MS=900000       # 15 min
# AUTH_LOGIN_RATE_MAX=10                 # failed logins per window before 429
# BETTER_AUTH_URL=https://api.example.com  # public base URL (Better Auth cookies/links)
# AUTH_TRUSTED_ORIGINS=https://app.example.com  # SPA origins for credentialed CORS + CSRF

# ── Companies module (in-process cutover, Phase 2) ────────────────────────────
# When "true", the TypeScript companies module is mounted at /api/companies ahead
# of the proxy (requires DATABASE_URL). Sessions are validated via the shared
# Better Auth guard. When unset/false, /api/companies falls through to legacy.
# COMPANIES_MODULE_ENABLED=false
# GRAPH_TENANT_ID / GRAPH_CLIENT_ID / GRAPH_CLIENT_SECRET / GRAPH_SENDER_EMAIL
#   — Microsoft Graph emailer (reset codes); console stub is used if unset.
