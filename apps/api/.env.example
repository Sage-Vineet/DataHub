# Gateway (apps/api) configuration.

# Port the gateway listens on.
PORT=8080

# Required. The legacy backend origin the gateway forwards to by default.
# In local dev the legacy backend (./backend) typically runs on :4000.
LEGACY_ORIGIN=http://127.0.0.1:4000

# Optional. Origin for new TypeScript modules, referenced by GATEWAY_ROUTES.
# API_ORIGIN=http://127.0.0.1:8081

# Optional. Per-route-group cutover table: comma/newline separated "prefix=origin".
# With this empty, 100% of traffic goes to legacy (transparent no-op).
# Example (flip auth to a separate service origin): GATEWAY_ROUTES=/api/auth=api
# GATEWAY_ROUTES=

# ── Auth module (in-process cutover) ──────────────────────────────────────────
# When "true", the TypeScript auth module is mounted at /api/auth ahead of the
# proxy (requires DATABASE_URL). When unset/false, /api/auth falls through to
# legacy. This flag is the instant cutover/rollback switch (design D2).
# AUTH_MODULE_ENABLED=false
# DATABASE_URL=postgres://...            # required when AUTH_MODULE_ENABLED=true
# JWT_SECRET=...                         # required; mandatory + fail-closed
# JWT_EXPIRES_IN=7d
# AUTH_LOGIN_RATE_WINDOW_MS=900000       # 15 min
# AUTH_LOGIN_RATE_MAX=10                 # failed logins per window before 429
